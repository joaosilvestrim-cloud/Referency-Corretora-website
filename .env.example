# Copie para .env.local e preencha. Sao chaves PUBLICAS do Supabase.
# A anon key vive no frontend por design, protegida por RLS (a tabela leads
# so aceita INSERT, nunca SELECT). NUNCA use a service_role key aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
